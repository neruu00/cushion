# Supabase — Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth
# 배포 시 배포 도메인으로 바꾼다. 안 바꿔도 로그인은 돌지만 /admin·/settings/tokens가
# 출력하는 설치 스니펫이 localhost를 가리킨다 (Vercel이면 VERCEL_PROJECT_PRODUCTION_URL로 폴백)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth — GCP Console > APIs & Services > Credentials
# 승인된 리디렉션 URI에 {NEXTAUTH_URL}/api/auth/callback/google 추가
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# admin 이메일 (콤마 구분). 비어 있으면 전원 거부 — fail-closed
ADMIN_EMAILS=
