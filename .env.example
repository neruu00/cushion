# Supabase — Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth
# 배포 시 배포 도메인으로 바꾼다. 안 바꿔도 로그인은 돌지만 설치 스니펫과 알림 메시지의
# 링크가 localhost를 가리킨다 (Vercel이면 VERCEL_PROJECT_PRODUCTION_URL로 폴백)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth — GCP Console > APIs & Services > Credentials
# 승인된 리디렉션 URI에 {NEXTAUTH_URL}/api/auth/callback/google 추가
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# admin 이메일 (콤마 구분). 비어 있으면 전원 거부 — fail-closed
ADMIN_EMAILS=

# 화면에 찍는 시각의 기준 시간대. 안 주면 Asia/Seoul.
# /admin의 요청 수는 여기 안 걸린다 — 거기선 UTC가 표기가 아니라 집계 키다
CUSHION_TZ=Asia/Seoul
